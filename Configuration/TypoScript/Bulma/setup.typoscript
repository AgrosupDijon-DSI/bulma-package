##############
#### PAGE ####
##############
page {
  includeCSS {
    theme = EXT:bulma_package/Resources/Public/Vite/Bulma.css
  }
  includeCSSLibs {
    fontawesome = EXT:bulma_package/Resources/Public/Vite/Fontawesome.css
    ionicons = EXT:bulma_package/Resources/Public/Vite/Ionicons.css
  }
  includeJSFooterlibs {
    tabs = EXT:bulma_package/Resources/Public/Vite/Tabs.entry.js
    tabs.type = module

    simplebar = EXT:bulma_package/Resources/Public/Vite/Simplebar.entry.js
    simplebar.type = module

    bulma_accordion = EXT:bulma_package/Resources/Public/Vite/Collapsible.entry.js
    bulma_accordion.type = module

    bulma_burger = EXT:bulma_package/Resources/Public/Vite/Burger.entry.js
    bulma_burger.type = module

    bulma_lightbox = EXT:bulma_package/Resources/Public/Vite/Photoswipe.entry.js
    bulma_lightbox.type = module

    bulma_flickity = EXT:bulma_package/Resources/Public/Vite/Flickity.entry.js
    bulma_flickity.type = module

    bulma_form = EXT:bulma_package/Resources/Public/Vite/Form.entry.js
    bulma_form.type = module

    bulma_scrolltop = EXT:bulma_package/Resources/Public/Vite/Scrolltop.entry.js
    bulma_scrolltop.type = module

    bulma_dropdown = EXT:bulma_package/Resources/Public/Vite/Dropdown.entry.js
    bulma_dropdown.type = module

    shareon = EXT:bulma_package/Resources/Public/Vite/Shareon.entry.js
    shareon.defer = 1

    slim-select = EXT:bulma_package/Resources/Public/Vite/SlimSelect.entry.js
    slim-select.type = module
  }
}

# Bulma light theme
config.htmlTag.attributes.data-theme = light
