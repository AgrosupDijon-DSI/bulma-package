####################################
#### NEW CONTENT ELEMENT WIZARD ####
####################################
mod.wizards.newContentElement.wizardItems.advanced {
  elements {
    iframe {
      iconIdentifier = content-bulmapackage-iframe
      title = bulma_package.backend:content_element.iframe
      description = bulma_package.backend:content_element.iframe.description
      tt_content_defValues {
        CType = iframe
      }
    }
  }
  show := addToList(iframe)
}
