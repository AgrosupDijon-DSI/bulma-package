####################################
#### NEW CONTENT ELEMENT WIZARD ####
####################################
mod.wizards.newContentElement.wizardItems.advanced {
  elements {
    accordion {
      iconIdentifier = content-bulmapackage-accordion
      title = bulma_package.backend:content_element.accordion
      description = bulma_package.backend:content_element.accordion.description
      tt_content_defValues {
        CType = accordion
      }
    }
  }
  show := addToList(accordion)
}
