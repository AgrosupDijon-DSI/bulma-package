####################################
#### NEW CONTENT ELEMENT WIZARD ####
####################################
mod.wizards.newContentElement.wizardItems.advanced {
  elements {
    div {
      iconIdentifier = content-special-div
      title = frontend.ttc:CType.div
      description = frontend.ttc:CType.div.description
      tt_content_defValues {
        CType = div
      }
      saveAndClose = true
    }
  }
  show := addToList(div)
}
mod.wizards.newContentElement.wizardItems.special.show := removeFromList(div)
