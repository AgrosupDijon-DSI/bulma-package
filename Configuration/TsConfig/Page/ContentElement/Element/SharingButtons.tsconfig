####################################
#### NEW CONTENT ELEMENT WIZARD ####
####################################
mod.wizards.newContentElement.wizardItems.advanced {
  elements {
    sharing_buttons {
      iconIdentifier = actions-share-alt
      title = bulma_package.backend:content_element.sharing_buttons
      description = bulma_package.backend:content_element.sharing_buttons.description
      tt_content_defValues {
        CType = sharing_buttons
      }
    }
  }
  show := addToList(sharing_buttons)
}
