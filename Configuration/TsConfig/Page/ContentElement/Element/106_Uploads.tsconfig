####################################
#### NEW CONTENT ELEMENT WIZARD ####
####################################
mod.wizards.newContentElement.wizardItems.advanced {
  elements {
    uploads {
      iconIdentifier = content-special-uploads
      title = frontend.ttc:CType.uploads
      description = frontend.ttc:CType.uploads.description
      tt_content_defValues {
        CType = uploads
      }
    }
  }
  show := addToList(uploads)
}
mod.wizards.newContentElement.wizardItems.common.show := removeFromList(uploads)
