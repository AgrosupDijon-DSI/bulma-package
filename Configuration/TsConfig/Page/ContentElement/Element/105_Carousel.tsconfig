####################################
#### NEW CONTENT ELEMENT WIZARD ####
####################################
mod.wizards.newContentElement.wizardItems.advanced {
  elements {
    carousel {
      iconIdentifier = content-bulmapackage-carousel
      title = bulma_package.backend:content_element.carousel
      description = bulma_package.backend:content_element.carousel.description
      tt_content_defValues {
        CType = carousel
      }
    }
  }
  show := addToList(carousel)
}
