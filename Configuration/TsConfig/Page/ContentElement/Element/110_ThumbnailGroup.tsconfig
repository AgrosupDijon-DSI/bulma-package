####################################
#### NEW CONTENT ELEMENT WIZARD ####
####################################
mod.wizards.newContentElement.wizardItems.advanced {
  elements {
    thumbnail_group {
      iconIdentifier = content-menu-thumbnail
      title = bulma_package.backend:content_element.thumbnail_group
      description = bulma_package.backend:content_element.thumbnail_group.description
      tt_content_defValues {
        CType = thumbnail_group
      }
    }
  }
  show := addToList(thumbnail_group)
}
