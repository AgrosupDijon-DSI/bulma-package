####################################
#### NEW CONTENT ELEMENT WIZARD ####
####################################
mod.wizards.newContentElement.wizardItems.advanced {
  elements {
    icon_group {
      iconIdentifier = content-bulmapackage-icon-group
      title = bulma_package.backend:content_element.icon_group
      description = bulma_package.backend:content_element.icon_group.description
      tt_content_defValues {
        CType = icon_group
      }
    }
  }
  show := addToList(icon_group)
}
