####################################
#### NEW CONTENT ELEMENT WIZARD ####
####################################
mod.wizards.newContentElement.wizardItems.advanced {
  elements {
    message {
      iconIdentifier = content-panel
      title = bulma_package.backend:content_element.message
      description = bulma_package.backend:content_element.message.description
      tt_content_defValues {
        CType = message
      }
    }
  }
  show := addToList(message)
}
