####################################
#### NEW CONTENT ELEMENT WIZARD ####
####################################
mod.wizards.newContentElement.wizardItems.advanced {
  elements {
    tab {
      iconIdentifier = content-bulmapackage-tab
      title = bulma_package.backend:content_element.tab
      description = bulma_package.backend:content_element.tab.description
      tt_content_defValues {
        CType = tab
      }
    }
  }
  show := addToList(tab)
}
