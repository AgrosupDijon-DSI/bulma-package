####################################
#### NEW CONTENT ELEMENT WIZARD ####
####################################
mod.wizards.newContentElement.wizardItems.media {
  elements {
    textmedia {
      iconIdentifier = content-textmedia
      title = frontend.ttc:CType.textmedia
      description = frontend.ttc:CType.textmedia.description
      tt_content_defValues {
        CType = textmedia
      }
    }
  }
  show := addToList(textmedia)
}
mod.wizards.newContentElement.wizardItems.common.show := removeFromList(textmedia)
