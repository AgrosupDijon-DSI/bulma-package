####################################
#### NEW CONTENT ELEMENT WIZARD ####
####################################
mod.wizards.newContentElement.wizardItems.advanced {
  elements {
    html {
      iconIdentifier = content-special-html
      title = frontend.ttc:CType.html
      description = frontend.ttc:CType.html.description
      tt_content_defValues {
        CType = html
      }
    }
  }
  show := addToList(html)
}
mod.wizards.newContentElement.wizardItems.special.show := removeFromList(html)
