####################################
#### NEW CONTENT ELEMENT WIZARD ####
####################################
mod.wizards.newContentElement.wizardItems.menu {
  elements {
    menu_card_list {
      iconIdentifier = content-bulmapackage-menu-card
      title = bulma_package.backend:menu.card_list
      description = bulma_package.backend:menu.card_list.description
      tt_content_defValues {
        CType = menu_card_list
      }
    }
  }
  show := addToList(menu_card_list)
}
