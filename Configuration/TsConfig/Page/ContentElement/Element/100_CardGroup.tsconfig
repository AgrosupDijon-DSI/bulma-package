####################################
#### NEW CONTENT ELEMENT WIZARD ####
####################################
mod.wizards.newContentElement.wizardItems.advanced {
  elements {
    card_group {
      iconIdentifier = content-bulmapackage-card-group
      title = bulma_package.backend:content_element.card_group
      description = bulma_package.backend:content_element.card_group.description
      tt_content_defValues {
        CType = card_group
      }
    }
  }
  show := addToList(card_group)
}
