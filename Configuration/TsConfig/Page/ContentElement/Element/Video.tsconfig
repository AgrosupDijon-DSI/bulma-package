####################################
#### NEW CONTENT ELEMENT WIZARD ####
####################################
mod.wizards.newContentElement.wizardItems.media {
  elements {
    video {
      iconIdentifier = mimetypes-x-content-multimedia
      title = bulma_package.backend:content_element.video
      description = bulma_package.backend:content_element.video.description
      tt_content_defValues {
        CType = video
      }
    }
  }
  show := addToList(video)
}
