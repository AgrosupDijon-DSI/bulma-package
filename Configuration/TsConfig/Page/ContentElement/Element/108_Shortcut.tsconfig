####################################
#### NEW CONTENT ELEMENT WIZARD ####
####################################
mod.wizards.newContentElement.wizardItems.advanced {
  elements {
    shortcut {
      iconIdentifier = content-special-shortcut
      title = frontend.ttc:CType.shortcut
      description = frontend.ttc:CType.shortcut.description
      tt_content_defValues {
        CType = shortcut
      }
    }
  }
  show := addToList(shortcut)
}
mod.wizards.newContentElement.wizardItems.special.show := removeFromList(shortcut)
