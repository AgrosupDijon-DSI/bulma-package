####################################
#### NEW CONTENT ELEMENT WIZARD ####
####################################
mod.wizards.newContentElement.wizardItems.menu {
  elements {
    menu_thumbnail_list {
      iconIdentifier = content-menu-thumbnail
      title = bulma_package.backend:menu.thumbnail_list
      description = bulma_package.backend:menu.thumbnail_list.description
      tt_content_defValues {
        CType = menu_thumbnail_list
      }
    }
  }
  show := addToList(menu_thumbnail_list)
}
