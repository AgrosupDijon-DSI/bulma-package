#################
#### TCEFORM ####
#################
TCEFORM {
  pages {
    layout {
      removeItems = 1,2,3
    }
  }
  tt_content {
    header {
      types {
        div {
          label = bulma_package.backend:field.header
        }
      }
    }
    header_layout {
      altLabels {
        1 = H1
        2 = H2
        3 = H3
        4 = H4
        5 = H5
      }
    }
    header_position {
      removeItems = center
      addItems {
        centered = frontend.ttc:header_position.I.1
      }
    }
    layout {
      removeItems = 1,2,3
      disableNoMatchingValueElement = 1
      types {
        uploads {
          removeItems = 1,2
          altLabels {
            3 = bulma_package.backend:content_layout.cards
          }
        }
      }
      types.shortcut.disabled = 1
    }
    frame_class {
      removeItems = none, ruler-before, ruler-after, indent, indent-left, indent-right
      addItems {
        fullwidth = bulma_package.backend:content_frame.fullwidth
        hero = bulma_package.backend:content_frame.hero
        desktop = bulma_package.backend:content_frame.desktop
      }
      types.shortcut.disabled = 1
    }
    space_before_class.types.shortcut.disabled = 1
    space_after_class.types.shortcut.disabled = 1
    background_color_class.types.shortcut.disabled = 1

    table_class {
      addItems {
        hoverable = bulma_package.backend:tablelayout.hoverable
        narrow = bulma_package.backend:tablelayout.narrow
      }
      types {
        tab {
          removeItems = striped, bordered, hoverable, narrow
          addItems {
            boxed = bulma_package.backend:tablayout.field.table_class.boxed
            toggle = bulma_package.backend:tablayout.field.table_class.toggle
            toggle-rounded = bulma_package.backend:tablayout.field.table_class.toggle-rounded
          }
          label = bulma_package.backend:tablayout.field.table_class
        }
        card_group {
          removeItems = fullwidth, striped, bordered, hoverable, narrow
          addItems {
            no-border = bulma_package.backend:menu.card.style.no-border
            is-centered = bulma_package.backend:option.is-centered
            is-gapless = bulma_package.backend:option.is-gapless
            is-vcentered = bulma_package.backend:option.is-vcentered
          }
          label = bulma_package.backend:field.style
        }
        menu_card_dir {
          removeItems = fullwidth, striped, bordered, hoverable, narrow
          addItems {
            no-border = bulma_package.backend:menu.card.style.no-border
            is-centered = bulma_package.backend:option.is-centered
            is-gapless = bulma_package.backend:option.is-gapless
            is-vcentered = bulma_package.backend:option.is-vcentered
          }
          label = bulma_package.backend:field.style
        }
        menu_card_list {
          removeItems = fullwidth, striped, bordered, hoverable, narrow
          addItems {
            no-border = bulma_package.backend:menu.card.style.no-border
            is-centered = bulma_package.backend:option.is-centered
            is-gapless = bulma_package.backend:option.is-gapless
            is-vcentered = bulma_package.backend:option.is-vcentered
          }
          label = bulma_package.backend:field.style
        }
        uploads {
          removeItems = fullwidth, striped, bordered, hoverable, narrow
          addItems {
            no-border = bulma_package.backend:menu.card.style.no-border
            is-centered = bulma_package.backend:option.is-centered
            is-gapless = bulma_package.backend:option.is-gapless
            is-vcentered = bulma_package.backend:option.is-vcentered
          }
          label = bulma_package.backend:field.style
        }
        icon_group {
          removeItems = fullwidth, striped, bordered, hoverable, narrow
          addItems {
            has-text-centered = bulma_package.backend:option.text-center
            has-text-right = bulma_package.backend:option.text-right
            is-centered = bulma_package.backend:option.is-centered
            is-gapless = bulma_package.backend:option.is-gapless
            is-vcentered = bulma_package.backend:option.is-vcentered
            has-items-center = bulma_package.backend:option.has-items-center
            has-items-end = bulma_package.backend:option.has-items-end
            boxed = bulma_package.backend:tablayout.field.table_class.boxed
          }
          label = bulma_package.backend:field.style
        }
        thumbnail_group {
          removeItems = fullwidth, striped, bordered, hoverable, narrow
          addItems {
            is-centered = bulma_package.backend:option.is-centered
            is-gapless = bulma_package.backend:option.is-gapless
            is-vcentered = bulma_package.backend:option.is-vcentered
            inverted-thumbnail = bulma_package.backend:option.inverted
          }
          label = bulma_package.backend:field.style
        }
        menu_thumbnail_dir {
          removeItems = fullwidth, striped, bordered, hoverable, narrow
          addItems {
            is-centered = bulma_package.backend:option.is-centered
            is-gapless = bulma_package.backend:option.is-gapless
            is-vcentered = bulma_package.backend:option.is-vcentered
            inverted-thumbnail = bulma_package.backend:option.inverted
          }
          label = bulma_package.backend:field.style
        }
        menu_thumbnail_list {
          removeItems = fullwidth, striped, bordered, hoverable, narrow
          addItems {
            is-centered = bulma_package.backend:option.is-centered
            is-gapless = bulma_package.backend:option.is-gapless
            is-vcentered = bulma_package.backend:option.is-vcentered
            inverted-thumbnail = bulma_package.backend:option.inverted
          }
          label = bulma_package.backend:field.style
        }
        image {
          removeItems = fullwidth, striped, bordered, hoverable, narrow
          addItems {
            is-centered = bulma_package.backend:option.is-centered
            is-gapless = bulma_package.backend:option.is-gapless
            is-vcentered = bulma_package.backend:option.is-vcentered
            is-justify-content-space-between = bulma_package.backend:option.is-spaced
          }
          label = bulma_package.backend:field.style
        }
        video {
          removeItems = fullwidth, striped, bordered, hoverable, narrow
          addItems {
            is-centered = bulma_package.backend:option.is-centered
            is-gapless = bulma_package.backend:option.is-gapless
            is-vcentered = bulma_package.backend:option.is-vcentered
          }
          label = bulma_package.backend:field.style
        }
        textmedia {
          removeItems = fullwidth, striped, bordered, hoverable, narrow
          addItems {
            is-centered = bulma_package.backend:option.is-centered
            is-gapless = bulma_package.backend:option.is-gapless
            is-vcentered = bulma_package.backend:option.is-vcentered
          }
          label = bulma_package.backend:field.style
        }
        textpic {
          removeItems = fullwidth, striped, bordered, hoverable, narrow
          addItems {
            is-centered = bulma_package.backend:option.is-centered
            is-gapless = bulma_package.backend:option.is-gapless
            is-vcentered = bulma_package.backend:option.is-vcentered
          }
          label = bulma_package.backend:field.style
        }
        iframe {
          removeItems = fullwidth, striped, bordered, hoverable, narrow
          addItems {
            mx-auto = bulma_package.backend:option.is-centered
          }
          label = bulma_package.backend:field.style
        }
      }
    }
    table_header_position {
      types {
        tab {
          altLabels {
            0 = bulma_package.backend:option.left
            1 = bulma_package.backend:option.center
            2 = bulma_package.backend:option.right
          }
          label = bulma_package.backend:field.alignement
        }
        card_group {
          altLabels {
            0 = bulma_package.backend:option.left
            1 = bulma_package.backend:option.center
            2 = bulma_package.backend:option.right
          }
          label = bulma_package.backend:menu.card.align
        }
        icon_group {
          altLabels {
            0 = bulma_package.backend:option.left
            1 = bulma_package.backend:option.top
            2 = bulma_package.backend:option.right
          }
          addItems {
            3 = bulma_package.backend:option.bottom
          }
          label = bulma_package.backend:field.icon-alignement
        }
        menu_card_list {
          altLabels {
            0 = bulma_package.backend:option.left
            1 = bulma_package.backend:option.center
            2 = bulma_package.backend:option.right
          }
          label = bulma_package.backend:menu.card.align
        }
        menu_card_dir {
          altLabels {
            0 = bulma_package.backend:option.left
            1 = bulma_package.backend:option.center
            2 = bulma_package.backend:option.right
          }
          label = bulma_package.backend:menu.card.align
        }
        uploads {
          altLabels {
            0 = bulma_package.backend:option.left
            1 = bulma_package.backend:option.center
            2 = bulma_package.backend:option.right
          }
          label = bulma_package.backend:menu.card.align
        }
        iframe {
          altLabels {
            0 = bulma_package.backend:ratio.16_9
            1 = bulma_package.backend:ratio.3_1
            2 = bulma_package.backend:ratio.3_2
          }
          addItems {
            3 = bulma_package.backend:ratio.4_3
            4 = bulma_package.backend:ratio.4_1
            5 = bulma_package.backend:ratio.6_1
            6 = bulma_package.backend:ratio.1_1
            7 = bulma_package.backend:ratio.2_3
            8 = bulma_package.backend:ratio.1_2
            9 = bulma_package.backend:ratio.4_5
          }
          label = bulma_package.backend:iframe.ratio
        }
        sharing_buttons {
          removeItems = 2
          altLabels {
            0 = bulma_package.backend:option.left
            1 = bulma_package.backend:option.right
          }
          label = bulma_package.backend:field.alignement
        }
        site_update {
          altLabels {
            0 = bulma_package.backend:option.left
            1 = bulma_package.backend:option.center
            2 = bulma_package.backend:option.right
          }
          label = bulma_package.backend:field.alignement
        }
      }
    }
    message_class {
      types {
        site_update {
          removeItems = is-dark, is-light
          addItems {
            has-text-grey-light = bulma_package.backend:option.grey-light
          }
          label = bulma_package.backend:field.style
        }
      }
    }
    cols {
      types {
        table {
          disabled = 1
        }
        menu_card_list {
          removeItems = 5,6,7,8,9
        }
        menu_card_dir {
          removeItems = 5,6,7,8,9
        }
        uploads {
          removeItems = 5,6,7,8,9
        }
        menu_thumbnail_dir {
          removeItems = 5,6,7,8,9
        }
        menu_thumbnail_list {
          removeItems = 5,6,7,8,9
        }
        card_group {
          removeItems = 5,6,7,8,9
        }
        icon_group {
          removeItems = 0,5,6,7,8,9
        }
      }
    }
    imageborder {
      disabled = 1
    }
    imagecols {
      removeItems = 7,8
    }
    image_zoom {
      types {
        video {
          disabled = 1
        }
      }
    }
    imageorient {
      removeItems = 1,2,9,10
      types {
        image {
          disabled = 1
        }
        video {
          disabled = 1
        }
      }
    }
    accessibility_title {
      disabled = 1
    }
    // Disable imageheight and imagewidth for textpic and image
    // to avoid incorrect rendering in frontend
    imageheight.disabled = 1
    imagewidth.disabled = 1
  }
  tx_bulmapackage_settings {
    header_layout {
      removeItems = 1,2,3
    }
  }
  tx_klaroconsentmanager_configuration {
    color_scheme {
      removeItems = light_neutral, dark_neutral
    }
  }
}

# Disable automatic_title by default
TCEFORM.pages.automatic_title.disabled = 1

# Enable automatic_title field, and change default to 1
# when automaticPageTitle is set to 1
[traverse(site("configuration"), "settings/automaticPageTitle") == 1]
  TCEFORM.pages.automatic_title.disabled = 0
  TCAdefaults.pages.automatic_title = 1
[end]
